{
  "mcpServers": {
    "coach": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--frozen",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/server",
        "coach-mcp"
      ]
    },
    "garmin": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "git+https://github.com/Taxuspt/garmin_mcp@202913fde53c9d15890d661fc9748dc6d0d5af52",
        "garmin-mcp"
      ]
    }
  }
}
