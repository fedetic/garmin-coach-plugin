{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --frozen --project \"${CLAUDE_PLUGIN_ROOT}/server\" coach-session start",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --frozen --project \"${CLAUDE_PLUGIN_ROOT}/server\" coach-session end",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
